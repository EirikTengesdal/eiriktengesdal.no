---
layout: default
---
<div class="post">
  <header class="post-header">
    <h2 class="post-title">{{ page.title | markdownify | remove: '<p>' | remove: '</p>' }}</h2>
    <p class="post-description">{{ page.description | markdownify }}</p>
  </header>

  <article>
    {{ content }}

    {% if page.data %}
      {% assign pdf_path = page.data | prepend: '/assets/pdf/statements/' | relative_url %}

      <!-- 1. Consistent Download Link (Works everywhere) -->
      <p>
        PDF copy {{ page.pdfcomment }}:
        <a
          href="{{ pdf_path }}"
          target="_blank"
          title="Download the full PDF: {{ page.data }}"
          rel="noopener noreferrer"
          class="none"
        >
          <i class="fa-solid fa-file-pdf"></i> Download PDF
        </a>
      </p>

      <!-- 2. Embedded Viewer using <iframe> (Better compatibility than <object>) -->
      <h3>Preview Document</h3>
      <p><small>If the preview below doesn't load on your mobile device, please use the "Download PDF" link above to view it in your phone's native PDF viewer.</small></p>

      <div class="pdf-container">
        <iframe
          src="{{ pdf_path }}"
          width="100%"
          height="900px"
          title="Embedded PDF Preview"
          frameborder="0"
          loading="lazy"
        >
        </iframe>
      </div>
      
    {% endif %}
  </article>
</div>
